# ==========================================
# Amazon ML Challenge 2026 - .gitignore
# ==========================================

# 1. Raw Datasets (Multi-Gigabyte TSVs)
dataset/
dataset/train/
dataset/test/
*.tar.gz

# 2. Large Submission Archives (> 100 MB GitHub limit)
*.zip
submission.zip
team_submission.zip

# 3. Intermediate & Cached Artifacts
output/interim/
output/*_backup.tsv
*.parquet
*.feather
*.log

# 4. Python Environment & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 5. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 6. IDEs & Operating System Artifacts
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# 7. Antigravity & Agent Scratch Logs
.system_generated/
scratch/
